{
  "name": "monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=\"./apps/*\"",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "tailwind:init": "./node_modules/.bin/tailwindcss-cli init -p"
  },
  "pnpm": {
    "allowedBuildScripts": [
      "sharp",
      "supabase",
      "unrs-resolver",
      "tailwindcss",
      "@tailwindcss/cli",
      "@parcel/watcher"
    ],
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "sharp",
      "supabase",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "supabase": "^2.54.11",
    "tailwindcss": "^3.4.0",
    "turbo": "^2.6.0",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.20.0+sha512.cf9998222162dd85864d0a8102e7892e7ba4ceadebbf5a31f9c2fce48dfce317a9c53b9f6464d1ef9042cba2e02ae02a9f7c143a2b438cd93c91840f0192b9dd",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@supabase/supabase-js": "^2.80.0"
  }
}
